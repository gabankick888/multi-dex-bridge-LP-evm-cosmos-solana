pragma solidity ^0.8.24;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

contract OmniFlow is Ownable, ReentrancyGuard {

    struct Pool {
        address tokenA;
        address tokenB;
        uint256 reserveA;
        uint256 reserveB;
        uint256 totalShares;
    }

    struct BridgeRequest {
        address sender;
        address token;
        uint256 amount;
        uint256 destinationChain;
        bool completed;
    }

    mapping(uint256 => Pool) public pools;
    mapping(address => mapping(uint256 => uint256))
        public lpShares;

    mapping(uint256 => BridgeRequest) public bridges;

    uint256 public poolCount;
    uint256 public bridgeCount;

    event PoolCreated(uint256 poolId);
    event LiquidityAdded(uint256 poolId, address user, uint256 shares);
    event LiquidityRemoved(uint256 poolId, address user);
    event SwapExecuted(uint256 poolId, address user, uint256 amountOut);
    event BridgeRequested(uint256 bridgeId, uint256 destinationChain);

    constructor() Ownable(msg.sender) {}

    // Create liquidity pool
    function createPool(
        address tokenA,
        address tokenB
    ) external onlyOwner {

        require(tokenA != tokenB, "Same token");
        require(tokenA != address(0) && tokenB != address(0), "Zero address");

        poolCount++;

        pools[poolCount] = Pool({
            tokenA: tokenA,
            tokenB: tokenB,
            reserveA: 0,
            reserveB: 0,
            totalShares: 0
        });

        emit PoolCreated(poolCount);
    }

    // Add liquidity
    function addLiquidity(
        uint256 poolId,
        uint256 amountA,
        uint256 amountB
    ) external nonReentrant {

        Pool storage pool = pools[poolId];

        require(pool.tokenA != address(0), "Pool not found");
        require(amountA > 0 && amountB > 0, "Invalid amount");

        IERC20(pool.tokenA).transferFrom(
            msg.sender, address(this), amountA
        );

        IERC20(pool.tokenB).transferFrom(
            msg.sender, address(this), amountB
        );

        uint256 shares;

        if (pool.totalShares == 0) {
            shares = sqrt(amountA * amountB);
        } else {
            uint256 shareA = amountA * pool.totalShares / pool.reserveA;
            uint256 shareB = amountB * pool.totalShares / pool.reserveB;
            shares = shareA < shareB ? shareA : shareB;
        }

        require(shares > 0, "Zero shares");

        pool.reserveA += amountA;
        pool.reserveB += amountB;
        pool.totalShares += shares;

        lpShares[msg.sender][poolId] += shares;

        emit LiquidityAdded(poolId, msg.sender, shares);
    }

    // Basic AMM swap
    function swap(
        uint256 poolId,
        address tokenIn,
        uint256 amountIn
    ) external nonReentrant returns (uint256 amountOut) {

        Pool storage pool = pools[poolId];

        require(amountIn > 0, "Invalid amount");

        bool aToB = tokenIn == pool.tokenA;
        require(aToB || tokenIn == pool.tokenB, "Invalid token");

        uint256 reserveIn = aToB ? pool.reserveA : pool.reserveB;
        uint256 reserveOut = aToB ? pool.reserveB : pool.reserveA;

        require(reserveIn > 0 && reserveOut > 0, "Empty pool");

        IERC20(tokenIn).transferFrom(
            msg.sender, address(this), amountIn
        );

        uint256 amountWithFee = amountIn * 997;

        amountOut = (amountWithFee * reserveOut) /
            (reserveIn * 1000 + amountWithFee);

        require(amountOut > 0 && amountOut < reserveOut, "Invalid output");

        if (aToB) {
            pool.reserveA += amountIn;
            pool.reserveB -= amountOut;
            IERC20(pool.tokenB).transfer(msg.sender, amountOut);
        } else {
            pool.reserveB += amountIn;
            pool.reserveA -= amountOut;
            IERC20(pool.tokenA).transfer(msg.sender, amountOut);
        }

        emit SwapExecuted(poolId, msg.sender, amountOut);
    }

    // Remove liquidity
    function removeLiquidity(
        uint256 poolId,
        uint256 shares
    ) external nonReentrant {

        Pool storage pool = pools[poolId];

        require(shares > 0, "Invalid shares");
        require(lpShares[msg.sender][poolId] >= shares, "Insufficient LP");

        uint256 amountA = shares * pool.reserveA / pool.totalShares;
        uint256 amountB = shares * pool.reserveB / pool.totalShares;

        lpShares[msg.sender][poolId] -= shares;
        pool.totalShares -= shares;
        pool.reserveA -= amountA;
        pool.reserveB -= amountB;

        IERC20(pool.tokenA).transfer(msg.sender, amountA);
        IERC20(pool.tokenB).transfer(msg.sender, amountB);

        emit LiquidityRemoved(poolId, msg.sender);
    }

    // Request cross-chain bridge
    function requestBridge(
        address token,
        uint256 amount,
        uint256 destinationChain
    ) external nonReentrant {

        require(amount > 0, "Invalid amount");
        require(destinationChain != 0, "Invalid destination");

        IERC20(token).transferFrom(
            msg.sender, address(this), amount
        );

        bridgeCount++;

        bridges[bridgeCount] = BridgeRequest({
            sender: msg.sender,
            token: token,
            amount: amount,
            destinationChain: destinationChain,
            completed: false
        });

        emit BridgeRequested(bridgeCount, destinationChain);
    }

    function completeBridge(
        uint256 bridgeId
    ) external onlyOwner {

        BridgeRequest storage request = bridges[bridgeId];

        require(request.sender != address(0), "Invalid request");
        require(!request.completed, "Already completed");

        request.completed = true;
    }

    function sqrt(uint256 x) internal pure returns (uint256 y) {
        if (x == 0) return 0;

        y = x;
        uint256 z = (x + 1) / 2;

        while (z < y) {
            y = z;
            z = (x / z + z) / 2;
        }
    }
}
